# Dengo 3D Lab - Environment Variables

# Backend API Configuration
# API URL (default is local or mock)
VITE_API_BASE_URL=http://localhost:3000/api

# Feature Flags
# Enable this to connect to a real backend instead of the mock API
VITE_USE_MOCK_API=false

# Store Settings
VITE_APP_NAME="Dengo 3D"
VITE_COMPANY_CNPJ="12.345.678/0001-90"
VITE_SUPPORT_EMAIL="contato@dengo3d.com"

# Analytics / Third-party (example)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXX
